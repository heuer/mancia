root = true

[*]
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf
charset = utf-8

[Makefile]
indent_style = tab

[*.{nim,nimble}]
indent_size = 2

[*.html]
indent_size = 2

[*.scd]
indent_size = 4
indent_style = tab

[{tests/**}]
trim_trailing_whitespace = false

